<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <!-- Border layer -->
    <ImageView
        android:id="@+id/widget_border_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_rounded_rect"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <!-- Inner background layer (slightly smaller for border effect) -->
    <ImageView
        android:id="@+id/widget_inner_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:src="@drawable/widget_rounded_rect"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/widget_button"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_tvt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NO-BARRIER"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/sv_fontawesome_road_barrier_s_f"
                android:contentDescription="Barrier Icon" />

            <ImageView
                android:id="@+id/widget_icon2"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/sv_fontawesome_brain_solid_full"
                android:contentDescription="Barrier Icon 2" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_progress"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:visibility="gone" >

        <ProgressBar
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:indeterminateDrawable="@drawable/widget_progressbar_custom" />
    </LinearLayout>
</FrameLayout>